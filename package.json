{
  "name": "texas-holdem-online",
  "version": "1.0.0",
  "description": "在线德州扑克游戏 - 支持最多7人同时在线",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "test:ai": "node scripts/benchmark-ai.js",
    "check": "node --check server/index.js && node --check server/game.js && node --check public/app.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "socket.io-client": "^4.8.4"
  },
  "overrides": {
    "qs": "6.16.2"
  }
}
